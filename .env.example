# ===== MediRAG 环境变量配置模板 =====
# 复制为 .env 后填写。.env 已被 .gitignore 排除，切勿提交真实密钥！

# ---------- 后端基础 ----------
SPRING_PROFILES_ACTIVE=prod

# 数据库（docker compose 下 host 用 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=medirag
DB_USERNAME=root
DB_PASSWORD=change_me_strong_password

# Redis（docker compose 下 host 用 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# MinIO（docker compose 下 endpoint 用 http://minio:9000）
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET_NAME=medirag

# Milvus（docker compose 下 host 用 milvus）
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=medical_knowledge
MILVUS_DIMENSION=1024

# ---------- 安全 ----------
# JWT 密钥：至少 32 字节。生成示例: openssl rand -base64 48
JWT_SECRET=PLEASE_REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS 允许来源（逗号分隔；设为 * 表示放开所有来源且不携带凭据）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- LLM / Embedding ----------
# 任何 OpenAI 兼容接口（DashScope / DeepSeek / OpenAI / 本地 vLLM 等）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3
LLM_TIMEOUT_SECONDS=60

# ---------- 重排序（可选） ----------
# 留空则后端自动降级为本地词法混合打分
RERANKER_API_URL=
RERANKER_MODEL=
# reranker-service 容器内模型（仅该服务读取）
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ---------- RAG 参数（可在 AI 配置中心热调整，此处为初始值） ----------
RAG_VECTOR_TOP_K=24
RAG_BM25_TOP_K=24
RAG_RRF_TOP_N=36
RAG_RERANK_TOP_K=8
RAG_RRF_K=60
SAFETY_CONFIDENCE_THRESHOLD=0.45
RAG_CACHE_FREQ_THRESHOLD=2

# ---------- Embedding 降级开关（强烈建议 false，见 docs/rag-pipeline.md） ----------
EMBEDDING_ALLOW_PSEUDO_FALLBACK=false

# ---------- API 文档（生产建议 false） ----------
# SPRINGDOC_API_DOCS_ENABLED=true  # 如需在 yml 中引用该变量请自行调整
